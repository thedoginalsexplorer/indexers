    "fuel": 1000000
   },
   "expect": {
    "ok": true,
    "contract_writes": {
     "1:0": {
      "6b": "ee"
     }
    },
    "ledger_writes": {}
   }
  },
  {
   "name": "bad_return_buffer_discards_child",
   "source": "dogex src/alkanes/runtime.rs test bad_return_buffer_discards_child_writes",
   "module": "rollback_parent_bad_buffer.wat",
   "contracts": {
