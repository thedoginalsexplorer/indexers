  },
  {
   "name": "grandchild_rolls_back_with_failed_middle",
   "source": "dogex src/alkanes/runtime.rs test grandchild_commit_rolls_back_with_failed_middle_frame",
   "module": "rollback_parent_grandchild.wat",
   "contracts": {
    "9:2": "writer_child_ok.wat",
    "9:3": "rollback_middle.wat"
   },
   "params": {
    "height": 50,
    "tx_index": 3,
    "block_time": 0,
    "myself": "1:0",
    "caller": "0:0",
    "calldata_hex": "",
    "fuel": 1000000
   },
   "expect": {
    "ok": true,
    "contract_writes": {
     "1:0": {
      "6b": "ee"
     },
     "9:2": {
      "6b": "0100000000000000"
     }
    },
    "ledger_writes_note": "exactly one mint of 5 to token 9:2 account 'A' (0x41)"
   }
  },
  {
   "name": "start_function_out_of_fuel",
