(module
  (import "env" "storage_set" (func $set (param i32 i32 i32 i32)))
  (import "env" "call" (func $call (param i64 i64 i32 i32 i32 i32 i64) (result i32)))
  (import "env" "staticcall" (func $sc (param i64 i64 i32 i32 i32 i32 i64) (result i32)))
  (import "env" "return_data" (func $ret (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "k")
  (data (i32.const 1) "\ee")
  (func (export "__dalk_execute") (param i32 i32) (result i32)
    (call $set (i32.const 0) (i32.const 1) (i32.const 1) (i32.const 1))
    (if (i32.ne (call $call (i64.const 9) (i64.const 2) (i32.const 0) (i32.const 0)
          (i32.const 100) (i32.const 8) (i64.const 200000)) (i32.const 8))
      (then (i32.const 11) (return)))
    (if (i32.ne (call $call (i64.const 9) (i64.const 2) (i32.const 0) (i32.const 0)
          (i32.const 100) (i32.const 8) (i64.const 200000)) (i32.const 8))
      (then (i32.const 12) (return)))
    ;; staticcall sees the staged counter (2) and bumps it to 3, then is discarded.
    (if (i32.ne (call $sc (i64.const 9) (i64.const 2) (i32.const 0) (i32.const 0)
          (i32.const 100) (i32.const 8) (i64.const 200000)) (i32.const 8))
      (then (i32.const 13) (return)))
    (if (i64.ne (i64.load (i32.const 100)) (i64.const 3)) (then (i32.const 14) (return)))
    (i32.const 0)))
