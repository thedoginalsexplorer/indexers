(module
  (import "env" "ledger_mint" (func $mint (param i64 i64 i32 i32 i64 i64) (result i32)))
  (import "env" "ledger_transfer" (func $x (param i64 i64 i32 i32 i32 i32 i64 i64) (result i32)))
  (import "env" "ledger_get" (func $get (param i64 i64 i32 i32 i32) (result i32)))
  (import "env" "return_data" (func $ret (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "A")
  (func (export "__dalk_execute") (param i32 i32) (result i32)
    (drop (call $mint (i64.const 5) (i64.const 0) (i32.const 0) (i32.const 1)
      (i64.const 100) (i64.const 0)))
    (if (i32.ne (call $x (i64.const 5) (i64.const 0) (i32.const 0) (i32.const 1)
          (i32.const 0) (i32.const 1) (i64.const 60) (i64.const 0)) (i32.const 1))
      (then (i32.const 2) (return)))
    (if (i32.ne (call $x (i64.const 5) (i64.const 0) (i32.const 0) (i32.const 1)
          (i32.const 0) (i32.const 1) (i64.const 60) (i64.const 0)) (i32.const 1))
      (then (i32.const 3) (return)))
    ;; More than the balance still fails.
    (if (i32.ne (call $x (i64.const 5) (i64.const 0) (i32.const 0) (i32.const 1)
          (i32.const 0) (i32.const 1) (i64.const 101) (i64.const 0)) (i32.const 0))
      (then (i32.const 4) (return)))
    (drop (call $get (i64.const 5) (i64.const 0) (i32.const 0) (i32.const 1) (i32.const 32)))
    (call $ret (i32.const 32) (i32.const 16))
    (i32.const 0)))
